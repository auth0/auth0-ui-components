# Auth0 Configuration
VITE_AUTH0_DOMAIN=your-auth0-domain.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id

# Feature Flags
VITE_ENABLE_MY_ACCOUNT=false

# Advanced (optional) — overrides the query cache's staleTime in ms.
# Leave unset to use the package default (2 minutes).
# VITE_QUERY_STALE_TIME_MS=0
