# Tenant + example-app config — see ../functional-tests/plan/tenant-ci-setup.md
FT_AUTH0_DOMAIN=
FT_AUTH0_SPA_CLIENT_ID=

# CI test user — made an admin member of the run's ephemeral organization
FT_TEST_USER_EMAIL=
FT_TEST_USER_PASSWORD=

# M2M app used ONLY for setup, teardown, and independent verification.
# Deliberately has no `update:organizations` grant — only the component under
# test may modify organization details.
FT_AUTH0_MGMT_CLIENT_ID=
FT_AUTH0_MGMT_CLIENT_SECRET=

# Optional — resolved by name at runtime, defaults shown. Override only if the
# tenant was not provisioned by examples/scripts/bootstrap.mjs.
FT_CONNECTION_NAME=
FT_ADMIN_ROLE_NAME=

